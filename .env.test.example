# Dedicated PostgreSQL database used only by Playwright.
E2E_DATABASE_URL="postgresql://user:password@localhost:5432/gymflow_e2e"
E2E_SESSION_SECRET=""

# These credentials must match the dedicated E2E database seed.
E2E_OWNER_EMAIL="e2e-owner@gymflow.test"
E2E_OWNER_PASSWORD="replace-with-test-password"
E2E_STAFF_EMAIL="e2e-staff@gymflow.test"
E2E_STAFF_PASSWORD="replace-with-test-password"

